{
  "description": "Cost-discipline PreToolUse guard: block plugin-source archaeology, same-hash PNG re-reads, and generic researcher teammates. Does not block first image Read.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/cost_guard.py\""
          }
        ]
      },
      {
        "matcher": "Skill|WebSearch|WebFetch|Agent|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "student-presentation-suite:.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "student-presentation-suite:.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ]
  }
}
