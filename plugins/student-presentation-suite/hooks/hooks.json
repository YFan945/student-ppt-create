{
  "description": "Research isolation and provenance only; PPTX authoring runs in the main session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Write|Edit|PowerShell|Skill|WebSearch|WebFetch|Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_dispatcher.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "student-presentation-suite:presentation-researcher",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "student-presentation-suite:presentation-researcher",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|PowerShell|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ]
  }
}
