{
  "description": "Cost-discipline and execution-integrity guards for the student presentation pipeline.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/production_entry_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/cost_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_health.py\""
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/builder_guard.py\""
          }
        ]
      },
      {
        "matcher": "Skill|WebSearch|WebFetch|Agent|SendMessage|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "student-presentation-suite:.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "student-presentation-suite:.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|PowerShell|WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime_evidence.py\""
          }
        ]
      }
    ]
  }
}
