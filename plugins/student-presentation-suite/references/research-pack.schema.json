{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-presentation-suite.local/research-pack.schema.json",
  "title": "Research Pack",
  "description": "sp-research 的唯一交付物：把互联网原始信息压缩为可追溯、可引用的结构化结论，供 sp-outline 与 sp-deck 直接消费。规则见 research-workflow.md；本文件只约束形状，语义检查（来源分级、交叉验证）见 scripts/validate_research_pack.py。",
  "type": "object",
  "required": [
    "version",
    "topic",
    "findings",
    "sources"
  ],
  "additionalProperties": true,
  "properties": {
    "evidence_contract": {
      "enum": [
        "text-bound-v1",
        "source-backed-v1"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "entity_id",
          "source_id"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "text_path": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "description": "Optional tool-owned cache/version metadata, not a content validity gate."
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "support_note": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "context_excerpt": {
            "type": "string"
          },
          "support_check": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "verdict"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supported",
                  "qualified",
                  "unsupported"
                ]
              },
              "subject_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "time_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "causal_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string"
              }
            }
          },
          "method": {
            "type": "string",
            "description": "How this source was read: browser, PDF parser, OCR, fetch-text, table, or user material."
          }
        },
        "anyOf": [
          {
            "required": [
              "excerpt"
            ]
          },
          {
            "required": [
              "support_note"
            ]
          }
        ]
      }
    },
    "version": {
      "const": "0.10"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601"
    },
    "budget": {
      "enum": [
        "simple",
        "standard",
        "deep"
      ],
      "description": "Legacy metadata; no runtime budget limit."
    },
    "queries": {
      "type": "array",
      "description": "实际执行过的检索词，用于复现与审计。只记录执行了的，不记录计划中的。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "description": "被证据支持的论述，是 sp-outline 的直接输入。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source_ids"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 4
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "conflict": {
            "type": "boolean",
            "description": "来源之间存在实质分歧"
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "enum": [
              "located",
              "usable",
              "verified",
              "unresolved"
            ]
          },
          "verification": {
            "enum": [
              "source",
              "text",
              "cross_check"
            ]
          },
          "support_check": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "verdict"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supported",
                  "qualified",
                  "unsupported"
                ]
              },
              "subject_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "time_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "causal_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string"
              }
            }
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "data_points": {
      "type": "array",
      "description": "可以在页面上直接引用的数字。必须能落到具体来源，且 high 置信度需要多源。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "meaning",
          "source_ids"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 2
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "conflict": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "description": "低置信度、口径差异或其他限制的说明"
          },
          "status": {
            "enum": [
              "located",
              "usable",
              "verified",
              "unresolved"
            ]
          },
          "verification": {
            "enum": [
              "source",
              "text",
              "cross_check"
            ]
          },
          "support_check": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "verdict"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supported",
                  "qualified",
                  "unsupported"
                ]
              },
              "subject_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "time_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "causal_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string"
              }
            }
          },
          "limitations": {
            "type": "string"
          },
          "source_value": {
            "type": "string",
            "description": "Original value before an explicitly explained display conversion."
          },
          "transformation": {
            "type": "string",
            "description": "Explain rounding, unit conversion or arithmetic; do not invent a source value."
          }
        }
      }
    },
    "quotes": {
      "type": "array",
      "description": "直接引语。与 findings 分开，避免把观点当成事实。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source_id"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 2
          },
          "attribution": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "located",
              "usable",
              "verified",
              "unresolved"
            ]
          },
          "verification": {
            "enum": [
              "source",
              "text",
              "cross_check"
            ]
          },
          "support_check": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "verdict"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "supported",
                  "qualified",
                  "unsupported"
                ]
              },
              "subject_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "time_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "causal_scope": {
                "enum": [
                  "matches",
                  "not_applicable",
                  "mismatch"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "string"
              }
            }
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "全部来源。tier 见 research-workflow.md 的分级表。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "independence_group": {
            "type": "string",
            "minLength": 1,
            "description": "Optional shared origin/group; matching groups merge. Domain names alone do not establish common origin."
          },
          "independence_note": {
            "type": "string",
            "description": "Optional explanation of source independence."
          },
          "sha256": {
            "type": "string"
          },
          "type": {
            "enum": [
              "user-file",
              "law-and-regulation",
              "official-database",
              "official-document",
              "paper",
              "standard",
              "research-institute",
              "university",
              "international-organization",
              "company-filing",
              "news",
              "industry-report",
              "vendor-blog",
              "community",
              "personal-blog",
              "other"
            ]
          },
          "tier": {
            "enum": [
              "S",
              "A",
              "B",
              "C",
              "D"
            ],
            "description": "页脚标注元数据（不是门禁）：S 官方文件/法规/官方数据库/论文原文/政府数据；A 顶会论文/权威机构/高校/国际组织/上市公司财报；B 主流媒体；C 技术或行业博客；D 论坛与个人内容。如实填写即可；不为它检索，它不决定置信度。条目只靠观点类来源（论坛/个人博客/厂商博客）支撑时不拒绝，但记 minor advisory（opinion_only_support），页面须表述为“社区/厂商观点”。"
          },
          "origin_id": {
            "type": "string",
            "minLength": 1,
            "description": "原始报告/数据集标识；转载和引用同一数据必须使用相同标识，independence_note 不可绕过。"
          },
          "publisher": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "locator": {
            "type": "string",
            "description": "无法给 URL 时的定位信息（DOI、卷期页、报告编号）"
          },
          "credibility": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "accessed_at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "来源之间的实质分歧。宁可标出来，也不要随便挑一个数字。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "entries"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 2
          },
          "entries": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "value",
                "source_id"
              ],
              "additionalProperties": true,
              "properties": {
                "value": {
                  "type": "string"
                },
                "source_id": {
                  "type": "string"
                }
              }
            }
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "受影响的 finding / data_point id"
          },
          "resolution": {
            "type": "string",
            "description": "如何取舍，或明确写未解决"
          }
        }
      }
    },
    "pack_author": {
      "enum": [
        "researcher",
        "import_user_materials"
      ]
    },
    "must_verify": {
      "type": "array",
      "description": "Optional task progress view. Tools derive unambiguous entity_ids/claim_id links; no claim-count quota or repeated claim wording audit.",
      "items": {
        "type": "object",
        "required": [
          "claim"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "located",
              "usable",
              "verified",
              "unresolved"
            ],
            "description": "verified = 可追溯来源支撑且无冲突（≥2 个独立来源印证可标 high）；unresolved = 降级收口，同样算关门，要写明缺失的主源与机制。等级不是 verified 的条件。"
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "工具可从实体的claim_id推导，不要求重复登记同一关系。"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "该 claim 已拿到的来源；status=unresolved 时同样要填——它记录“降级收口时手上有什么”，留空会丢掉这段证据。"
          }
        },
        "additionalProperties": true
      }
    },
    "knowledge_gaps": {
      "type": "array",
      "description": "识别出的、需要外部证据但目前缺失的论述。",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "reason"
        ],
        "additionalProperties": true,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 2
          },
          "research_needed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolved_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unresolved": {
            "type": "boolean"
          }
        }
      }
    },
    "visual_candidates": {
      "type": "array",
      "description": "适合可视化的材料。这是 PPT 研究与其他研究的分界点。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "priority"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_point_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "enum": [
              "line_chart",
              "bar_chart",
              "comparison",
              "timeline",
              "taxonomy",
              "process",
              "table",
              "diagram",
              "kpi"
            ]
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "description": "执行受阻的记录。检索打不开、来源不可得时必须写在这里，不许静默降级。reason 区分受阻机制：search_unavailable 是检索后端没返回结果（不是没有覆盖），not_found 是有覆盖但检索不到，access_blocked 是有覆盖但打不开。",
      "items": {
        "type": "object",
        "required": [
          "query",
          "reason",
          "impact"
        ],
        "additionalProperties": true,
        "properties": {
          "query": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "access_blocked",
              "not_found",
              "tier_unavailable",
              "paywalled",
              "search_unavailable"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "description": "对 PPT 论断的影响"
          }
        }
      }
    },
    "recommended_slide_usage": {
      "type": "array",
      "description": "建议用途，仅供参考；最终排页由 sp-outline 决定。",
      "items": {
        "type": "object",
        "required": [
          "ref_id",
          "usage"
        ],
        "additionalProperties": true,
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "suggested_role": {
            "type": "string"
          },
          "usage": {
            "type": "string"
          }
        }
      }
    }
  }
}
