{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "work_dir",
    "brief_path",
    "scope",
    "materials_path",
    "background",
    "claims"
  ],
  "properties": {
    "work_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "work_dir": {
      "type": "string",
      "minLength": 1
    },
    "brief_path": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "oneOf": [
        {
          "const": "A",
          "description": "必须查：时效性内容（最新数据、最新政策、最新版本、最新榜单、机构最新预测、产品现状）；必须联网，查不到进 unresolved，不得用模型记忆冒充（research-workflow.md §一）。"
        },
        {
          "const": "B",
          "description": "最好查：模型大概率知道但结论会被打分的内容（课程答辩、论文汇报、竞赛、正式提交）；查，拿不到降级为模型常识并在页面标注无来源（research-workflow.md §一）。"
        },
        {
          "const": "C",
          "description": "不用查：与外部事实无关的任务（过渡页、概括已有材料、重排用户结构）；不产生检索（research-workflow.md §一）。"
        },
        {
          "const": "D",
          "description": "禁止查：用户明确限定范围（只用上传论文/课程 PPT/不用外部资料）；禁止联网，import_user_materials.py 确定性导入用户材料，queries 为空（research-workflow.md §一）。"
        }
      ]
    },
    "materials_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "enum": [
        "simple",
        "standard",
        "deep"
      ],
      "description": "Legacy metadata; no runtime budget limit."
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "core",
              "supporting"
            ],
            "default": "core"
          },
          "verification": {
            "enum": [
              "source",
              "text",
              "cross_check"
            ],
            "default": "source"
          }
        }
      }
    },
    "time_budget_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy metadata; does not stop research."
    },
    "stall_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Legacy metadata; does not stop research."
    },
    "semantic_review_required": {
      "type": "boolean",
      "default": false,
      "description": "Require a second-pass support/scope review for every usable evidence binding; legacy tasks remain compatible."
    }
  }
}
